##### App Icon #####

def update_app_icon(tag)
  UI.header('Step: update_app_icon')

  appIconPath = File.expand_path("../Template/Assets/AppIcon.icon")
  appIconSetPath = File.expand_path("../Template/Assets/Assets.xcassets/AppIcon.appiconset")
  newAppIconPath = File.expand_path("../fastlane/assets/AppIcon-#{tag}.icon")
  newAppIconSetPath = File.expand_path("../fastlane/assets/AppIcon-#{tag}.appiconset")

  UI.message('Replacing icon...')

  # Handle .icon file
  if File.exist?(newAppIconPath)
    sh("rm -rf #{appIconPath}")
    sh("mv #{newAppIconPath} #{appIconPath}")
  else
    UI.message("New .icon not found: #{newAppIconPath}")
  end

  # Handle .appiconset independently
  if File.exist?(newAppIconSetPath)
    sh("rm -rf #{appIconSetPath}")
    sh("mv #{newAppIconSetPath} #{appIconSetPath}")
  else
    UI.message("New .appiconset not found: #{newAppIconSetPath}")
  end
end

